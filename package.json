{
  "name": "@antelopejs/file-storage-s3",
  "version": "0.1.2",
  "description": "A file storage module that implements the file-storage interface of AntelopeJS with S3-compatible backends (AWS S3, Cloudflare R2)",
  "repository": {
    "type": "git",
    "url": "https://github.com/AntelopeJS/file-storage-s3.git"
  },
  "keywords": [
    "antelopejs",
    "file-storage",
    "s3",
    "cloudflare-r2",
    "presigned-url",
    "upload"
  ],
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.6.5",
  "scripts": {
    "build": "rimraf dist && tsc",
    "dev": "ajs project run -w -p playground",
    "format": "oxfmt .",
    "lint:fix": "oxlint --fix",
    "lint": "oxlint",
    "prepack": "pnpm run build",
    "release": "pnpm run lint && pnpm run test && pnpm run prepack && release-it",
    "test": "pnpm run build && ajs module test .",
    "format:check": "oxfmt --check .",
    "knip": "knip"
  },
  "antelopeJs": {
    "implements": [
      "@antelopejs/interface-file-storage"
    ],
    "test": "src/test/antelope.test.ts"
  },
  "dependencies": {
    "@antelopejs/interface-core": ">=0.0.5 <1.0.0",
    "@antelopejs/interface-file-storage": ">=0.1.1 <1.0.0",
    "@aws-sdk/client-s3": "^3.1016.0",
    "@aws-sdk/s3-request-presigner": "^3.1016.0"
  },
  "devDependencies": {
    "@antelopejs/tooling-configs": "^0.0.4",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.19.15",
    "eslint-plugin-perfectionist": "^5.11.0",
    "knip": "^6.34.0",
    "oxfmt": "^0.66.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "release-it": "^19.2.4",
    "release-it-changelogen": "^0.1.0",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3"
  }
}
